<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/news_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Brand header -->
    <LinearLayout
        android:id="@+id/news_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/news_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@mipmap/launcher_icon" />

        <TextView
            android:id="@+id/news_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="LM Mini"
            android:textColor="#212121"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_news_title"
            android:textColor="#757575"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Compact list of up to 5 one-line headlines -->
    <TextView
        android:id="@+id/news_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lineSpacingExtra="4dp"
        android:maxLines="5"
        android:textColor="#212121"
        android:textSize="11sp"
        android:textStyle="normal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/news_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#757575"
        android:textSize="9sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/news_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textColor="#616161"
        android:textSize="12sp"
        android:visibility="visible" />

</LinearLayout>
