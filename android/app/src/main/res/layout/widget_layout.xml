<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_app_stats"
                android:textColor="#4527A0"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_premium_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="★"
                android:textColor="#F9A825"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_stat_messages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Messages: 0"
            android:textColor="#212121"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_stat_tokens_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tokens In: 0k"
            android:textColor="#616161"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_stat_tokens_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tokens Out: 0k"
            android:textColor="#616161"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Tap to chat"
            android:textColor="#757575"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_new_chat"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:background="@drawable/widget_new_chat_bg"
        android:contentDescription="New chat" />

</LinearLayout>
